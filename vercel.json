{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.yumo.lol" }],
      "destination": "https://yumo.lol/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yumo.lol" }],
      "destination": "https://yumo.lol/:path*",
      "permanent": true
    }
  ]
}
